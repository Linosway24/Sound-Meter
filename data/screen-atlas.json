[
    {
      "id": "boot_screen",
      "title": "Startup / Boot",
      "mode": "BOOT",
      "referenceImage": "capture/startup/boot_screen.jpg",
      "elements": [
        { "type": "label", "id": "fw", "text": "Quest SoundPro SE/DL" },
        { "type": "label", "id": "ver", "text": "Firmware v1.13J" }
      ],
      "softkeys": [],
      "keys": [],
      "display": { "backlight": false, "dwellMs": 1500 }
    },
    {
      "id": "home_screen_dim",
      "title": "START",
      "mode": "START",
      "referenceImage": "capture/startup/home_screen_dim.jpg",
      "elements": [
        { "type": "title", "id": "screen_title", "text": "START" },
        { "type": "divider", "id": "title_rule" },
        {
          "type": "textList",
          "id": "main_menu",
          "items": [
            "VIEW PAST STUDIES",
            "VIEW CURRENT STUDY",
            "VIEW SESSION",
            "SETUP",
            "UNIT INFO"
          ],
          "bind": "menu.selectedIndex"
        },
        {
          "type": "timer",
          "id": "context_timer",
          "bind": "measurement.runtime",
          "format": "hh:mm:ss",
          "visibleWhen": { "anySelectedEquals": ["VIEW CURRENT STUDY", "VIEW SESSION"] },
          "position": "top-right"
        },
        { "type": "softKeyRow", "id": "softkeys", "labels": ["{modeLabel}", "CAL", "FILE", "LOCK"] }
      ],
      "softkeys": ["{modeLabel}", "CAL", "FILE", "LOCK"],
      "keys": ["up", "down", "enter", "esc", "soft1", "soft2", "soft3", "soft4", "backlight", "power"],
      "display": { "backlight": false }
    },
    {
      "id": "home_screen",
      "title": "START",
      "mode": "START",
      "referenceImage": "capture/startup/home_screen.jpg",
      "elementsRef": "home_screen_dim",
      "softkeys": ["{modeLabel}", "CAL", "FILE", "LOCK"],
      "keys": ["up", "down", "enter", "esc", "soft1", "soft2", "soft3", "soft4", "backlight", "power"],
      "display": { "backlight": true }
    },
    {
      "id": "slm_home",
      "title": "SLM Running",
      "mode": "SLM",
      "referenceImage": "capture/operational/slm_home.jpeg",
      "elements": [
        { "type": "title", "id": "screen_title", "text": "SLM" },
        { "type": "label", "id": "status", "text": "RUNNING" },
        {
          "type": "timer",
          "id": "runtime",
          "bind": "measurement.runtime",
          "format": "hh:mm:ss"
        }
      ],
      "softkeys": ["VIEW", "", "", ""],
      "keys": ["runpause", "stop", "esc", "soft2"],
      "display": { "backlight": true }
    },
    {
      "id": "slm_home_paused",
